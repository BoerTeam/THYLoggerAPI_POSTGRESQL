@model Dashboard.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="loading" lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap | THY Logger</title>

    <link rel="stylesheet" href="~/app-assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" href="~/app-assets/css/bootstrap.css">
    <link rel="stylesheet" href="~/app-assets/css/bootstrap-extended.css">
    <link rel="stylesheet" href="~/app-assets/css/colors.css">
    <link rel="stylesheet" href="~/app-assets/css/components.css">
    <link rel="stylesheet" href="~/app-assets/css/pages/page-auth.css">

    @* Kendi özel CSS'ini eklemek istersen (Genişlik Kısıtlaması İçin) *@
    <style>
        .auth-wrapper.auth-v1 {
            display: flex;
            justify-content: center; /* Yatayda ortalar */
            align-items: center; /* Düşeyde ortalar */
            height: 100vh; /* Sayfa boyunu kaplar */
            background: #f8f8f8; /* Arka plan rengi */
        }

        .auth-inner {
            /* Genişliği kısıtlıyoruz (Tavsiye edilen: %30-%40 arası veya max-width) */
            width: 100%;
            max-width: 480px;
            box-shadow: 0 4px 24px 0 rgba(0, 0, 0, 0.1); /* Hafif gölge */
            border-radius: 12px;
            background: #fff;
        }

        .divider {
            position: relative;
            text-align: center;
            margin: 1.5rem 0;
        }

            .divider:before {
                content: "";
                position: absolute;
                top: 50%;
                left: 0;
                width: 100%;
                height: 1px;
                background: #e0e0e0;
            }

        .divider-text {
            position: relative;
            background: #fff;
            padding: 0 10px;
            font-size: 0.8rem;
            color: #b0b0b0;
        }
    </style>
</head>

<body class="vertical-layout vertical-menu-modern blank-page navbar-floating footer-static" data-open="click" data-menu="vertical-menu-modern" data-col="blank-page">

    <div class="auth-wrapper auth-v1 px-2">

        <div class="auth-inner py-4 px-3">

            <a href="javascript:void(0);" class="brand-logo d-flex justify-content-center align-items-center mb-3">
                <i data-feather="truck" style="width: 32px; height: 32px; color: #7367f0;"></i>
                
            </a>

            <div class="text-center mb-3">
                <h4 class="card-title mb-1">Hoş Geldiniz! 👋</h4>
                <p class="text-muted">Kurumsal LDAP hesabınız ile giriş yapın.</p>
            </div>

            <form class="auth-login-form" asp-action="Login" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-2 @(ViewData.ModelState.IsValid ? "d-none" : string.Empty)" role="alert"></div>

                <div class="mb-2">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" tabindex="1" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" tabindex="2" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-2" tabindex="3">LDAP ile Giriş Yap</button>
            </form>

            <div class="divider my-3">
                <div class="divider-text">veya</div>
            </div>

            <p class="text-center">
                <span class="text-muted">Sorun mu yaşıyorsunuz?</span><br />
                <a href="mailto:destek@thy.com" class="fw-bold">
                    <span>Sistem Yöneticisine Ulaşın</span>
                </a>
            </p>

        </div>
    </div>
    <script src="~/app-assets/vendors/js/vendors.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script>
        $(window).on('load', function() {
            if (feather) {
                feather.replace();
            }
            // Remove loading class
            $('html').removeClass('loading').addClass('loaded');
        });
    </script>
</body>
</html>