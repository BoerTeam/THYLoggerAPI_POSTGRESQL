@model MultiModel
@using Newtonsoft.Json
@using System.Globalization

<section id="modal-examples">
    <link href="~/map/leaflet.css" rel="stylesheet" />
    <script src="~/map/chart.js"></script>
    <script src="~/map/leaflet.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
    <div class="row">
        @foreach (var dolly in Model.DollyList)
        {
            // Veritabanı sorguları
            var sonSicaklik = Model.Sicaklik.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
            var sonNem = Model.nem.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
            var sonDurum = Model.bosDolu.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();

            // GPS verisini kendi tablosundan (Gpsdatum) çekiyoruz
            var sonGps = Model.gpsdatum.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
            double sicaklikDegeri = sonSicaklik?.Sicaklik1 ?? 0;
            // C# Tarafında Koordinat Formatlama (Nokta sorunu çözümü)
            string latVal = sonGps?.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "";
            string lngVal = sonGps?.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "";

            <div class="col-md-2 mb-2">
                <div class="card text-center doly-card" style="cursor:pointer;"
                     data-dolly-id="@dolly.Id"
                     data-doly-name="@dolly.Name"
                     data-doly-serial="@dolly.SerialNumber"
                     data-lat="@latVal"
                     data-lng="@lngVal"
                     data-status="@(sonDurum?.SensorDegeri == true ? "true" : "false")">

                    <div class="card-body" style="background-color: @(sicaklikDegeri <= 25 ? "#28c76f" : "#ea5455"); border-radius: 8px; padding: 1rem;">
                        <h5 class="fw-bolder text-white">@dolly.Name</h5>
                        <div class="row text-white">
                            <div class="col-md-6">
                                <small>Sıcaklık</small>
                                <h6 class="fw-bold">@(sonSicaklik?.Sicaklik1?.ToString("0.0") ?? "0")°C</h6>
                            </div>
                            <div class="col-md-6">
                                <small>Nem</small>
                                <h6 class="fw-bold">%@(sonNem?.Nem1?.ToString("0") ?? "0")</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="modal fade text-start" id="xlargeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Dolly Detay: <span id="modalDolyName" class="text-primary"></span></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-2">
                        <div class="col-md-3"><b>Seri No:</b> <span id="modalDolySerial"></span></div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" id="modalDoluBosCheck" disabled style="opacity: 1;">
                                <label class="form-check-label"><b>Boş/Dolu</b></label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="card shadow-none border">
                                <div class="card-header"><h4 class="card-title">Nem (%) </h4></div>
                                <div class="card-body" style="position: relative; height:250px;">
                                    <canvas id="humidityChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-none border">
                                <div class="card-header"><h4 class="card-title">Sıcaklık (°C) </h4></div>
                                <div class="card-body" style="position: relative; height:250px;">
                                    <canvas id="tempChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow-none border">
                                <div class="card-header"><h4 class="card-title">Konum</h4></div>
                                <div class="card-body">
                                    <div id="basic-map" style="height: 250px; width: 100%; border-radius: 8px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const allTemps = @Html.Raw(JsonConvert.SerializeObject(Model.Sicaklik)) || [];
    const allHumidities = @Html.Raw(JsonConvert.SerializeObject(Model.nem)) || [];

    let map, marker, tempChart, humChart;
    delete L.Icon.Default.prototype._getIconUrl;
        L.Icon.Default.mergeOptions({
            iconRetinaUrl: '/map/marker-icon-2x.png',
    iconUrl: '/map/marker-icon.png',
    shadowUrl: '/map/marker-shadow.png',
        })
    document.addEventListener("DOMContentLoaded", function () {
        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: false } }
        };

        // Grafik Kurulumları
        tempChart = new Chart(document.getElementById('tempChart'), {
            type: 'line',
            data: { labels: [], datasets: [{ label: 'Sıcaklık (°C)', borderColor: '#ea5455', backgroundColor: 'rgba(234, 84, 85, 0.1)', data: [], fill: true, tension: 0.3 }] },
            options: chartOptions
        });

        humChart = new Chart(document.getElementById('humidityChart'), {
            type: 'line',
            data: { labels: [], datasets: [{ label: 'Nem (%)', borderColor: '#00cfe8', backgroundColor: 'rgba(0, 207, 232, 0.1)', data: [], fill: true, tension: 0.3 }] },
            options: chartOptions
        });

        // Kartlara Tıklama Olayı
        document.querySelectorAll('.doly-card').forEach(card => {
            card.onclick = function () {
                const id = parseInt(this.getAttribute('data-dolly-id'));
                const name = this.getAttribute('data-doly-name');
                const serial = this.getAttribute('data-doly-serial');
                const latStr = this.getAttribute('data-lat');
                const lngStr = this.getAttribute('data-lng');
                const status = this.getAttribute('data-status') === "true";

                document.getElementById('modalDolyName').innerText = name;
                document.getElementById('modalDolySerial').innerText = serial;
                document.getElementById('modalDoluBosCheck').checked = status;

                const modalEl = document.getElementById('xlargeModal');
                modalEl.setAttribute('data-current-id', id);
                modalEl.setAttribute('data-current-lat', latStr);
                modalEl.setAttribute('data-current-lng', lngStr);

                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            };
        });

        const modalEl = document.getElementById('xlargeModal');
        modalEl.addEventListener('shown.bs.modal', function () {
            const id = parseInt(this.getAttribute('data-current-id'));

            // 1. GRAFİKLERİ GÜNCELLE
            const fTemps = allTemps.filter(x => (x.DollyId || x.dollyId) === id).slice(-15);
            const fHums = allHumidities.filter(x => (x.DollyId || x.dollyId) === id).slice(-15);

                tempChart.data.labels = fTemps.map(x => {
        const d = new Date(x.Time || x.time);
        if (isNaN(d)) return "";
        // UTC metodlarını kullanarak tarayıcının +3 eklemesini engelliyoruz
        const hours = d.getUTCHours().toString().padStart(2, '0');
        const minutes = d.getUTCMinutes().toString().padStart(2, '0');
        return `${hours}:${minutes}`;
    });
            tempChart.data.datasets[0].data = fTemps.map(x => x.Sicaklik1 ?? x.sicaklik1);
            tempChart.update();

                humChart.data.labels = fHums.map(x => {
        const d = new Date(x.Time || x.time);
        if (isNaN(d)) return "";

        // Tarayıcının +3 eklemesini engellemek için UTC saatini alıyoruz
        const hours = d.getUTCHours().toString().padStart(2, '0');
        const minutes = d.getUTCMinutes().toString().padStart(2, '0');

        return `${hours}:${minutes}`;
    });
            humChart.data.datasets[0].data = fHums.map(x => x.Nem1 ?? x.nem1);
            humChart.update();

                // 2. HARİTAYI GÜNCELLE
    setTimeout(() => {
        let rawLat = modalEl.getAttribute('data-current-lat');
        let rawLng = modalEl.getAttribute('data-current-lng');

        if (!rawLat || !rawLng || rawLat === "0" || rawLat === "") {
            document.getElementById('basic-map').innerHTML =
                "<div style='display:flex; justify-content:center; align-items:center; height:100%; color:gray;'>Konum Bilgisi Mevcut Değil</div>";
            return;
        }

        let cleanLat = rawLat.trim().replace(/\s+/g, '.').replace(',', '.');
        let cleanLng = rawLng.trim().replace(/\s+/g, '.').replace(',', '.');

        const lat = parseFloat(cleanLat);
        const lng = parseFloat(cleanLng);

        if (!isNaN(lat) && !isNaN(lng)) {
            if (map) { map.remove(); map = null; }

            map = L.map('basic-map').setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            marker = L.marker([lat, lng]).addTo(map);

            // --- ALAN KONTROLÜ EKLEMESİ (STATİK) ---

            // 1. İzin verilen alanı tanımla (Örn: Mevcut konumun biraz çevresi)
            // [GüneyBatıLat, GüneyBatıLng], [KuzeyDoğuLat, KuzeyDoğuLng]
            const bounds = [
                [lat - 0.01, lng - 0.01],
                [lat + 0.01, lng + 0.01]
            ];

            // 2. Alanı haritaya çiz (Görsel test için kırmızı dikdörtgen)
            const zone = L.rectangle(bounds, {color: "red", weight: 1}).addTo(map);

            // 3. Kontrolü yap
            const currentLatLng = L.latLng(lat, lng);

            if (!zone.getBounds().contains(currentLatLng)) {
                // Eğer konum alanın dışındaysa uyarı ver
                alert("⚠️ UYARI: Belirlenen güvenli alanın dışındasınız!");

                // İsterseniz marker rengini değiştirebilir veya haritayı kırmızı yapabilirsiniz
                marker.bindPopup("<b style='color:red;'>Alan Dışı Konum!</b>").openPopup();
            } else {
                console.log("Konum güvenli alan içerisinde.");
            }

            // --- ALAN KONTROLÜ SONU ---

            setTimeout(() => { map.invalidateSize(); }, 200);
        }
    }, 300);
        });
    });
        setInterval(function () {
        window.location.reload();
    }, 30000);
</script>