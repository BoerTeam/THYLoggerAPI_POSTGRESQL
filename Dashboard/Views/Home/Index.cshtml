@model MultiModel
@using Newtonsoft.Json
@using System.Globalization

@{
    ViewData["Title"] = "Ana Sayfa";
}

@if (!User.HasClaim("Permission", "DASHBOARD_VIEW") && !User.IsInRole("Admin"))
{
    <div class="alert alert-danger p-2 m-3" role="alert">
        <h4 class="alert-heading">🔒 Yetkisiz Erişim!</h4>
        <p class="mb-0">Ana Sayfa (Dashboard) modülünü görüntülemek için gerekli izne sahip değilsiniz.</p>
    </div>
}
else
{
    <section id="modal-examples">
        <!-- Dolly Kartları Listesi -->
        <div class="row">
            @foreach (var dolly in Model.DollyList)
            {
                var sonSicaklik = Model.Sicaklik.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
                var sonNem = Model.nem.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
                var sonDurum = Model.bosDolu.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
                var sonGps = Model.gpsdatum.Where(x => x.DollyId == dolly.Id).OrderByDescending(x => x.Time).FirstOrDefault();
                // Dolly'nin içindeki (açık talepteki) ULD No ve SCC bilgileri
var dollyOpen = Model.OpenRequests.Where(x => x.DollyId == dolly.Id).ToList();
string uldText = dollyOpen.Count > 0 ? string.Join(", ", dollyOpen.Select(x => x.UldNo)) : "-";
var sccList = dollyOpen.Where(x => !string.IsNullOrEmpty(x.SccCode)).Select(x => x.SccCode).Distinct().ToList();
string sccText = sccList.Count > 0 ? string.Join(", ", sccList) : "-";
                double sicaklikDegeri = sonSicaklik?.Sicaklik1 ?? 0;

                string latVal = sonGps?.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "";
                string lngVal = sonGps?.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "";

                <div class="col-md-2 mb-2">
                    <div class="card text-center doly-card" style="cursor:pointer;"
                         data-dolly-id="@dolly.Id"
                         data-doly-name="@dolly.Name"
                         data-doly-serial="@dolly.SerialNumber"
                         data-lat="@latVal"
                         data-lng="@lngVal"
                         data-status="@(sonDurum?.SensorDegeri == true ? "true" : "false")">

                        <div class="card-body" data-field="body" style="background-color: @(sicaklikDegeri <= 25 ? "#28c76f" : "#ea5455"); border-radius: 8px; padding: 1rem;">
                            <h5 class="fw-bolder text-white">@dolly.Name</h5>
                            <div class="row text-white">
                                <div class="col-md-6">
                                    <small>Sıcaklık</small>
                                    <h6 class="fw-bold" data-field="temp">@(sonSicaklik?.Sicaklik1?.ToString("0.0") ?? "0")°C</h6>
                                </div>
                                <div class="col-md-6">
                                    <small>Nem</small>
                                    <h6 class="fw-bold" data-field="nem">%@(sonNem?.Nem1?.ToString("0") ?? "0")</h6>
                                </div>
                            </div>
                            <div class="text-white mt-1 pt-1" style="border-top: 1px solid rgba(255,255,255,.4); font-size: .8rem;">
    <div>ULD: <b data-field="uld">@uldText</b></div>
    <div>SCC: <b data-field="scc">@sccText</b></div>
</div>
                            <small class="d-block text-white mt-1" style="opacity:.8" data-field="updated">@(sonSicaklik?.Time?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .map-location-label { background: rgba(255,255,255,.85); border: 0; box-shadow: none; font-weight: 600; font-size: 11px; padding: 1px 4px; }
            .map-labels-hidden .map-location-label { display: none; }
        </style>

        <!-- Dolly Detay Modal -->
        <div class="modal fade text-start" id="xlargeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content">
                    <div class="modal-header d-flex justify-content-between align-items-center">
                        <h4 class="modal-title mb-0">Dolly Detay: <span id="modalDolyName" class="text-primary"></span></h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">

                        <!-- Modal İçi Bilgiler ve Excel Filtre Barı -->
                        <div class="row align-items-center mb-3 bg-light p-2 rounded">
                            <div class="col-md-2">
                                <b>Seri No:</b> <span id="modalDolySerial"></span>
                            </div>
                            <div class="col-md-2">
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" class="form-check-input" id="modalDoluBosCheck" disabled style="opacity: 1;">
                                    <label class="form-check-label"><b>Boş/Dolu</b></label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                @if (User.HasClaim("Permission", "DOLLY_VIEW") || User.IsInRole("Admin"))
                                {
                                    <!-- Excel Rapor Filtre Formu (Tarih ve Saat Seçimli) -->
                                    <form action="/Home/ExportToExcel" method="get" class="row gx-2 align-items-center justify-content-end">
                                        <input type="hidden" name="dollyId" id="modalDollyIdInput" value="" />

                                        <div class="col-auto">
                                            <label class="form-label mb-0 small fw-bold">Başlangıç Tarihi & Saati:</label>
                                            <input type="text" name="startDate" class="form-control form-control-sm excel-datetime"
                                                   value="@DateTime.Now.AddDays(-7).ToString("yyyy-MM-ddTHH:mm")" required />
                                        </div>
                                        <div class="col-auto">
                                            <label class="form-label mb-0 small fw-bold">Bitiş Tarihi & Saati:</label>
                                            <input type="text" name="endDate" class="form-control form-control-sm excel-datetime"
                                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                                        </div>
                                        <div class="col-auto">
                                            <label class="form-label d-block mb-0 small">&nbsp;</label>
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="me-1">📊</i> Excel Raporu İndir
                                            </button>
                                        </div>
                                    </form>
                                }
                            </div>
                        </div>

                        <!-- Grafik zaman araligi secimi -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="chartRangeBar">
                            <span class="small fw-bold">Grafik Aralığı:</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary chart-range-btn" data-hours="1">Son 1 Saat</button>
                                <button type="button" class="btn btn-outline-primary chart-range-btn" data-hours="6">Son 6 Saat</button>
                                <button type="button" class="btn btn-outline-primary chart-range-btn active" data-hours="24">Son 24 Saat</button>
                            </div>
                            <input type="text" id="chartStart" class="form-control form-control-sm" style="width:160px" placeholder="Başlangıç" />
                            <input type="text" id="chartEnd" class="form-control form-control-sm" style="width:160px" placeholder="Bitiş" />
                            <button type="button" class="btn btn-primary btn-sm" id="chartApplyBtn">Uygula</button>
                            <span class="small text-muted" id="chartInfo"></span>
                        </div>

                        <!-- Grafikler ve Harita -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card shadow-none border">
                                    <div class="card-header"><h4 class="card-title">Nem (%) </h4></div>
                                    <div class="card-body" style="position: relative; height:250px;">
                                        <canvas id="humidityChart"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card shadow-none border">
                                    <div class="card-header"><h4 class="card-title">Sıcaklık (°C) </h4></div>
                                    <div class="card-body" style="position: relative; height:250px;">
                                        <canvas id="tempChart"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card shadow-none border">
                                    <div class="card-header"><h4 class="card-title">Konum</h4></div>
                                    <div class="card-body">
                                        <div id="basic-map" style="height: 250px; width: 100%; border-radius: 8px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <link rel="stylesheet" href="~/app-assets/vendors/css/pickers/flatpickr/flatpickr.min.css" />
        <script>

            let map, marker, tempChart, humChart;

            // --- Grafik verisini secilen aralik icin sunucudan getir ---
            const pad2 = n => n.toString().padStart(2, '0');
            const toIso = d => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}:00`;
            let chartStartPicker, chartEndPicker;

            // Saat secimi olan flatpickr takvimi kendiliginden kapanmaz; "Tamam" butonu ve disina tiklayinca kapanma ekler
            function wirePickerClosing(pickers) {
                const list = [].concat(pickers);
                list.forEach(fp => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-primary btn-sm w-100 mt-1';
                    btn.textContent = 'Tamam';
                    btn.addEventListener('click', () => fp.close());
                    fp.calendarContainer.appendChild(btn);
                });
                document.addEventListener('mousedown', e => {
                    list.forEach(fp => {
                        if (fp.isOpen && !fp.calendarContainer.contains(e.target) && !fp.altInput.contains(e.target)) fp.close();
                    });
                }, true);
            }

            // Modal acikken aria-hidden="true" kalirsa odaklanan alanlar icin tarayici uyarisi olusur; acikken temizle
            document.addEventListener('DOMContentLoaded', function () {
                const m = document.getElementById('xlargeModal');
                new MutationObserver(() => {
                    if (m.classList.contains('show') && m.getAttribute('aria-hidden') === 'true') m.removeAttribute('aria-hidden');
                }).observe(m, { attributes: true, attributeFilter: ['aria-hidden', 'class'] });
            });

            let currentRange = { hours: 24 };

            async function loadCharts(range) {
                currentRange = range.hours ? { hours: range.hours } : null;
                const id = parseInt(document.getElementById('xlargeModal').getAttribute('data-current-id'));
                let start, end;
                if (range.hours) {
                    end = new Date();
                    start = new Date(end.getTime() - range.hours * 3600000);
                    chartStartPicker?.setDate(start, false);
                    chartEndPicker?.setDate(end, false);
                } else {
                    start = range.start; end = range.end;
                }
                document.querySelectorAll('.chart-range-btn').forEach(b =>
                    b.classList.toggle('active', !!range.hours && parseInt(b.dataset.hours) === range.hours));

                const info = document.getElementById('chartInfo');
                info.textContent = 'Yükleniyor...';
                try {
                    const res = await fetch(`/Home/GetChartData?id=${id}&start=${encodeURIComponent(toIso(start))}&end=${encodeURIComponent(toIso(end))}`);
                    const data = await res.json();
                    if (data.error) { info.textContent = data.error; return; }

                    const longRange = (end - start) > 24 * 3600000;
                    const label = t => {
                        const d = new Date(t);
                        const hm = `${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
                        return longRange ? `${pad2(d.getDate())}/${pad2(d.getMonth() + 1)} ${hm}` : hm;
                    };
                    tempChart.data.labels = data.temps.map(x => label(x.t));
                    tempChart.data.datasets[0].data = data.temps.map(x => x.v);
                    tempChart.update();
                    humChart.data.labels = data.hums.map(x => label(x.t));
                    humChart.data.datasets[0].data = data.hums.map(x => x.v);
                    humChart.update();
                    info.textContent = data.temps.length + ' sıcaklık, ' + data.hums.length + ' nem kaydı';
                } catch (e) {
                    info.textContent = 'Veri alınamadı';
                }
            }

            delete L.Icon.Default.prototype._getIconUrl;
            L.Icon.Default.mergeOptions({
                iconRetinaUrl: '/lib/leaflet/images/marker-icon-2x.png',
                iconUrl: '/lib/leaflet/images/marker-icon.png',
                shadowUrl: '/lib/leaflet/images/marker-shadow.png',
            });

            document.addEventListener("DOMContentLoaded", function () {
                const chartPickerOpts = {
                    enableTime: true, time_24hr: true, altInput: true, altFormat: 'd/m/Y H:i',
                    dateFormat: 'Y-m-d\\TH:i', locale: { firstDayOfWeek: 1 },
                    static: true
                };
                chartStartPicker = flatpickr('#chartStart', chartPickerOpts);
                chartEndPicker = flatpickr('#chartEnd', chartPickerOpts);
                wirePickerClosing([chartStartPicker, chartEndPicker]);
                document.querySelectorAll('.chart-range-btn').forEach(btn =>
                    btn.addEventListener('click', () => loadCharts({ hours: parseInt(btn.dataset.hours) })));
                document.getElementById('chartApplyBtn').addEventListener('click', () => {
                    const s = chartStartPicker.selectedDates[0], e = chartEndPicker.selectedDates[0];
                    if (!s || !e || s >= e) { document.getElementById('chartInfo').textContent = 'Geçerli bir aralık seçin'; return; }
                    loadCharts({ start: s, end: e });
                });
            });

            document.addEventListener("DOMContentLoaded", function () {
                // Tarih gösterimi Gün/Ay/Yıl (gönderilen değer ISO kalır)
                const excelPickers = flatpickr('.excel-datetime', {
                    enableTime: true,
                    time_24hr: true,
                                minuteIncrement: 1,
                    altInput: true,
                    altFormat: 'd/m/Y H:i',
                    dateFormat: 'Y-m-d\TH:i',
                    locale: { firstDayOfWeek: 1 },
                    static: true
                });
                wirePickerClosing(excelPickers);
            });

            document.addEventListener("DOMContentLoaded", function () {
                // Layout'taki Chart.js v2.9.3 sozdizimi: Y ekseni sabit (nem 0-100, sicaklik en az 0-25; deger tasarsa genisler)
                const baseOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    elements: { point: { radius: 0, hitRadius: 6 } },
                    scales: { xAxes: [{ ticks: { maxTicksLimit: 12, maxRotation: 0 } }] }
                };
                const humOptions = {
                    ...baseOptions,
                    scales: { ...baseOptions.scales, yAxes: [{ ticks: { min: 0, max: 100 } }] }
                };
                const tempOptions = {
                    ...baseOptions,
                    scales: { ...baseOptions.scales, yAxes: [{ ticks: { min: 0, suggestedMax: 25 } }] }
                };

                tempChart = new Chart(document.getElementById('tempChart'), {
                    type: 'line',
                    data: { labels: [], datasets: [{ label: 'Sıcaklık (°C)', borderColor: '#ea5455', backgroundColor: 'rgba(234, 84, 85, 0.1)', data: [], fill: true, tension: 0.3 }] },
                    options: tempOptions
                });

                humChart = new Chart(document.getElementById('humidityChart'), {
                    type: 'line',
                    data: { labels: [], datasets: [{ label: 'Nem (%)', borderColor: '#00cfe8', backgroundColor: 'rgba(0, 207, 232, 0.1)', data: [], fill: true, tension: 0.3 }] },
                    options: humOptions
                });

                document.querySelectorAll('.doly-card').forEach(card => {
                    card.onclick = function () {
                        const id = parseInt(this.getAttribute('data-dolly-id'));
                        const name = this.getAttribute('data-doly-name');
                        const serial = this.getAttribute('data-doly-serial');
                        const latStr = this.getAttribute('data-lat');
                        const lngStr = this.getAttribute('data-lng');
                        const status = this.getAttribute('data-status') === "true";

                        document.getElementById('modalDolyName').innerText = name;
                        document.getElementById('modalDolySerial').innerText = serial;
                        document.getElementById('modalDoluBosCheck').checked = status;

                        const inputEl = document.getElementById('modalDollyIdInput');
                        if (inputEl) inputEl.value = id;

                        const modalEl = document.getElementById('xlargeModal');
                        modalEl.setAttribute('data-current-id', id);
                        modalEl.setAttribute('data-current-lat', latStr);
                        modalEl.setAttribute('data-current-lng', lngStr);

                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    };
                });

                const modalEl = document.getElementById('xlargeModal');
                modalEl.addEventListener('shown.bs.modal', function () {
                    const id = parseInt(this.getAttribute('data-current-id'));

                    loadCharts({ hours: 24 });

                    setTimeout(() => {
                        let rawLat = modalEl.getAttribute('data-current-lat');
                        let rawLng = modalEl.getAttribute('data-current-lng');

                        if (!rawLat || !rawLng || rawLat === "0" || rawLat === "") {
                            document.getElementById('basic-map').innerHTML =
                                "<div style='display:flex; justify-content:center; align-items:center; height:100%; color:gray;'>Konum Bilgisi Mevcut Değil</div>";
                            return;
                        }

                        let cleanLat = rawLat.trim().replace(/\s+/g, '.').replace(',', '.');
                        let cleanLng = rawLng.trim().replace(/\s+/g, '.').replace(',', '.');

                        const lat = parseFloat(cleanLat);
                        const lng = parseFloat(cleanLng);

                        if (!isNaN(lat) && !isNaN(lng)) {
                            if (map) { map.remove(); map = null; }

                            const mapTileBounds = L.latLngBounds(
                                L.latLng(41.1800, 28.6200),
                                L.latLng(41.3600, 28.8500)
                            );

                            map = L.map('basic-map', {
                                center: [lat, lng],
                                zoom: 14,
                                minZoom: 12,
                                maxZoom: 16,
                                maxBounds: mapTileBounds,
                                maxBoundsViscosity: 0.8,
                scrollWheelZoom: true,   // fare tekerlegi ile zoom
                zoomSnap: 0.25,
                zoomDelta: 0.5,
                wheelPxPerZoomLevel: 90
                            });

                            L.tileLayer('/map/files/{z}/{x}/{y}png.tile', {
                                minZoom: 12,
                                maxZoom: 16,
                                attribution: 'Offline Harita'
                            }).addTo(map);

                            marker = L.marker([lat, lng]).addTo(map);

                            // 449 pozisyon etiketi dusuk zoomda kalabalik yaptigi icin sadece yakinlasinca gosterilir
                            const toggleLabels = () => map.getContainer().classList.toggle('map-labels-hidden', map.getZoom() < 15);
                            map.on('zoomend', toggleLabels);
                            toggleLabels();

                            // Sabit lokasyonlar (wwwroot/map/locations.json); koordinati bos olanlar atlanir
                            const currentMap = map;
                            fetch('/map/locations.json')
                                .then(r => r.json())
                                .then(locs => locs.forEach(loc => {
                                    if (map !== currentMap) return;
                                    const style = { color: loc.color || '#7367f0', weight: 2, fillOpacity: 0.15 };
                                    let shape;
                                    if (loc.bounds) shape = L.rectangle(loc.bounds, style);          // [[y1,x1],[y2,x2]]
                                    else if (loc.lat != null && loc.lng != null) shape = L.circle([loc.lat, loc.lng], { ...style, radius: loc.radius || 100 });
                                    else return;
                                    shape.addTo(currentMap)
                                        .bindTooltip(loc.name, { permanent: true, direction: 'center', className: 'map-location-label' });
                                }))
                                .catch(() => { });

                            const popupText = `<b>Konum Koordinatları:</b><br>Lat: ${lat}<br>Lng: ${lng}`;
                            marker.bindPopup(popupText);

                            marker.bindTooltip(`<b>${document.getElementById('modalDolyName').innerText}</b><br>${lat.toFixed(5)}, ${lng.toFixed(5)}`, {
                                permanent: true,
                                direction: 'top',
                                offset: [0, -32]
                            }).openTooltip();

                            const bounds = L.latLngBounds([
                                [lat - 0.01, lng - 0.01],
                                [lat + 0.01, lng + 0.01]
                            ]);

                            if (!bounds.contains(L.latLng(lat, lng))) {
                                alert("⚠️ UYARI: Belirlenen güvenli alanın dışındasınız!");
                                marker.bindPopup(`<b style='color:red;'>Alan Dışı Konum!</b><br>Lat: ${lat}<br>Lng: ${lng}`).openPopup();
                            }

                            setTimeout(() => { map.invalidateSize(); }, 200);
                        }
                    }, 300);
                });
            });

            // --- Canli guncelleme (sayfa yenilemeden) ---
            async function refreshCards() {
                try {
                    const res = await fetch('/Home/GetLatestAll', { cache: 'no-store' });
                    if (!res.ok) return;
                    const list = await res.json();
                    if (!Array.isArray(list)) return;
                    const gelenIdler = new Set(list.map(d => d.dollyId));
document.querySelectorAll('.doly-card').forEach(card => {
    if (!gelenIdler.has(parseInt(card.getAttribute('data-dolly-id')))) {
        const u = card.querySelector('[data-field="uld"]'); if (u) u.textContent = '-';
        const s = card.querySelector('[data-field="scc"]'); if (s) s.textContent = '-';
    }
});
                    const modalEl = document.getElementById('xlargeModal');
                    const modalOpen = modalEl.classList.contains('show');
                    const openId = parseInt(modalEl.getAttribute('data-current-id'));

                    list.forEach(d => {
                        const card = document.querySelector(`.doly-card[data-dolly-id="${d.dollyId}"]`);
                        if (!card) return;

                        card.setAttribute('data-lat', d.lat ?? '');
                        card.setAttribute('data-lng', d.lng ?? '');
                        card.setAttribute('data-status', d.isFull ? 'true' : 'false');

                        const temp = d.sicaklik ?? 0;
                        card.querySelector('[data-field="body"]').style.backgroundColor = temp <= 25 ? '#28c76f' : '#ea5455';
                        card.querySelector('[data-field="temp"]').textContent = `${temp.toFixed(1).replace(',', '.')}°C`;
                        card.querySelector('[data-field="nem"]').textContent = `%${Math.round(d.nem ?? 0)}`;
                        card.querySelector('[data-field="updated"]').textContent = d.updated ?? '-';
                        const uldEl = card.querySelector('[data-field="uld"]');
if (uldEl) uldEl.textContent = d.uldNo || '-';
const sccEl = card.querySelector('[data-field="scc"]');
if (sccEl) sccEl.textContent = d.sccCode || '-';
                        // Detay penceresi bu dolly icin aciksa onu da guncelle
                        if (modalOpen && openId === d.dollyId) {
                            modalEl.setAttribute('data-current-lat', d.lat ?? '');
                            modalEl.setAttribute('data-current-lng', d.lng ?? '');
                            document.getElementById('modalDoluBosCheck').checked = !!d.isFull;

                            if (marker && map && d.lat != null && d.lng != null) {
                                const ll = L.latLng(d.lat, d.lng);
                                marker.setLatLng(ll);
                                marker.setTooltipContent(`<b>${document.getElementById('modalDolyName').innerText}</b><br>${d.lat.toFixed(5)}, ${d.lng.toFixed(5)}`);
                                marker.setPopupContent(`<b>Konum Koordinatları:</b><br>Lat: ${d.lat}<br>Lng: ${d.lng}`);
                                if (!map.getBounds().contains(ll)) map.panTo(ll);
                            }
                        }
                    });
                } catch (e) { /* bir sonraki turda tekrar denenir */ }
            }

            setInterval(refreshCards, 5000);

            // Detay penceresi aciksa ve hazir aralik seciliyse grafikleri de tazele
            setInterval(function () {
                if (document.querySelector('.modal.show') && currentRange) loadCharts(currentRange);
            }, 30000);
        </script>
    }
}