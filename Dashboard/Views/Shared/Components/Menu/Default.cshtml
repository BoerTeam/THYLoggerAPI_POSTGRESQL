@model List<Dashboard.ViewComponents.PageMenuDto>

<div class="main-menu-content">
    <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <li class="nav-item">
                    <a class="d-flex align-items-center" href="@item.Route">
                        <i data-feather="@(string.IsNullOrEmpty(item.Icon) ? "grid" : item.Icon)"></i>
                        <span class="menu-title text-truncate">@item.Name</span>
                    </a>
                </li>
            }
        }
    </ul>
</div>