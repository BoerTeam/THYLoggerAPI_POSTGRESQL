@model List<Dashboard.Controllers.RoleItemDto>
@{
    ViewData["Title"] = "Rol ve Yetki Yönetimi";
    var permissions = ViewBag.Permissions as List<Dashboard.Controllers.PermissionItemDto> ?? new List<Dashboard.Controllers.PermissionItemDto>();
    var roles = Model ?? new List<Dashboard.Controllers.RoleItemDto>();
}

<div class="content-body">
    <div class="row">
        <!-- Rol Oluşturma Formu -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Yeni Rol ve İzin Tanımla</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="RoleManagement" asp-action="CreateRole" method="post">
                        <div class="mb-1">
                            <label class="form-label">Rol Adı</label>
                            <input type="text" name="Name" class="form-control" required placeholder="Örn: Operatör" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label">Açıklama</label>
                            <input type="text" name="Description" class="form-control" placeholder="Rol açıklaması giriniz" />
                        </div>

                        <div class="mb-1">
                            <label class="form-label fw-bolder">Atanacak İzinler</label>
                            <div class="border p-1 rounded" style="max-height: 250px; overflow-y: auto;">
                                @if (permissions.Any())
                                {
                                    @foreach (var perm in permissions)
                                    {
                                        <div class="form-check mb-50">
                                            <input class="form-check-input" type="checkbox" name="PermissionIds" value="@perm.Id" id="perm-create-@perm.Id">
                                            <label class="form-check-label" for="perm-create-@perm.Id">
                                                @perm.Name <small class="text-muted">(@perm.Code)</small>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Tanımlı izin bulunamadı.</span>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-1">Rolü Oluştur</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Mevcut Rol Listesi ve İşlemler -->
        <div class="col-md-7">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Sistemdeki Roller</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Rol Adı</th>
                                    <th>Açıklama</th>
                                    <th>Tanımlı İzinler</th>
                                    <th class="text-center" style="width: 120px;">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (roles.Any())
                                {
                                    @foreach (var role in roles)
                                    {
                                        var rolePermIds = role.RolePermissions?.Select(rp => rp.PermissionId).ToList() ?? new List<int>();
                                        var rolePermIdsJson = System.Text.Json.JsonSerializer.Serialize(rolePermIds);

                                        <tr>
                                            <td>
                                                <span class="badge bg-light-primary fw-bolder fs-6">@role.Name</span>
                                            </td>
                                            <td>@role.Description</td>
                                            <td>
                                                @if (role.RolePermissions != null && role.RolePermissions.Any())
                                                {
                                                    @foreach (var rp in role.RolePermissions)
                                                    {
                                                        <span class="badge bg-light-secondary me-25 mb-25">@(rp.Permission?.Name ?? "İzin")</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">İzin atanmamış</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <!-- Düzenle Butonu -->
                                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                                            onclick="editRole(@role.Id, '@role.Name', '@role.Description', @rolePermIdsJson)">
                                                        Düzenle
                                                    </button>

                                                    <!-- Silme Formu -->
                                                    <form asp-controller="RoleManagement" asp-action="DeleteRole" method="post" onsubmit="return confirm('@role.Name rolünü silmek istediğinize emin misiniz?');" style="display:inline;">
                                                        <input type="hidden" name="id" value="@role.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Mevcut rol bulunamadı.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ROL DÜZENLEME MODAL -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rolü Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="RoleManagement" asp-action="UpdateRole" method="post">
                <div class="modal-body">
                    <input type="hidden" id="edit-role-id" name="Id" />
                    <div class="mb-1">
                        <label class="form-label">Rol Adı</label>
                        <input type="text" id="edit-role-name" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-1">
                        <label class="form-label">Açıklama</label>
                        <input type="text" id="edit-role-desc" name="Description" class="form-control" />
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-bolder">Atanacak İzinler</label>
                        <div class="border p-1 rounded" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var perm in permissions)
                            {
                                <div class="form-check mb-50">
                                    <input class="form-check-input edit-perm-checkbox" type="checkbox" name="PermissionIds" value="@perm.Id" id="perm-edit-@perm.Id">
                                    <label class="form-check-label" for="perm-edit-@perm.Id">
                                        @perm.Name <small class="text-muted">(@perm.Code)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editRole(id, name, description, permissionIds) {
        document.getElementById('edit-role-id').value = id;
        document.getElementById('edit-role-name').value = name;
        document.getElementById('edit-role-desc').value = description || '';

        // Tüm checkbox'ları sıfırla
        document.querySelectorAll('.edit-perm-checkbox').forEach(cb => cb.checked = false);

        // Rolün izinlerine göre ilgili checkbox'ları işaretle
        if (permissionIds && permissionIds.length > 0) {
            permissionIds.forEach(pId => {
                const cb = document.getElementById('perm-edit-' + pId);
                if (cb) cb.checked = true;
            });
        }

        // Modalı göster
        var editModal = new bootstrap.Modal(document.getElementById('editRoleModal'));
        editModal.show();
    }
</script>