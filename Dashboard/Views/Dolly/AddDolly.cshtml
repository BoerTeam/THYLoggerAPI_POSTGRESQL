@using Dashboard.DTO
@model Dolly

<div class="card">
    <div class="card-header border-bottom">
        <h4 class="card-title">Yeni Dolly Ekle</h4>
    </div>
    <div class="card-body mt-2">
        <form class="form form-vertical" asp-controller="Dolly" asp-action="AddDolly" method="post">
            <div class="row">
                <div class="col-12 col-md-6 mb-1">
                    <label class="form-label" for="SerialNumber">Seri Numarası</label>
                    <input type="text" asp-for="SerialNumber" class="form-control" placeholder="Örn: 2024001" required />
                </div>

                <div class="col-12 col-md-6 mb-1">
                    <label class="form-label" for="Name">Dolly İsmi</label>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Örn: TDC-V3" required />
                </div>

                <div class="col-12 mb-2">
                    <div class="form-check form-switch form-check-primary">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input" checked />
                        <label class="form-check-label" for="IsActive">Aktif Olarak Başlat</label>
                    </div>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a href="/Dolly/List" class="btn btn-outline-secondary">İptal</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(window).on('load', function() {
            if (feather) { feather.replace(); }
        });
    </script>
}