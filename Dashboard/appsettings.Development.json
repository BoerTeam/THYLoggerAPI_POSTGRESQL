{
  "Authentication": {
    "Ldap": {
      "Host": "<set-via-env:Authentication__Ldap__Host>",
      "Port": 389,
      "Domain": "<set-via-env:Authentication__Ldap__Domain>",
      "BaseDn": "<set-via-env:Authentication__Ldap__BaseDn>",
      "SearchFilter": "(sAMAccountName={0})",
      "UseSsl": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
